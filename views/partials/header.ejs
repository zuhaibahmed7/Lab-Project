<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== "undefined" ? title : "AlumniConnect" %> · Alumni Management System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="logo">AlumniConnect</div>
    <ul class="nav-links">
      <li><a href="/" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
      <li><a href="/alumni" class="<%= active === 'alumni' ? 'active' : '' %>">Alumni</a></li>
      <!-- <li><a href="#">Events</a></li> -->
      <li><a href="/register" class="<%= active === 'register' ? 'active' : '' %>">Register</a></li>
      <li><a href="/profile" class="<%= active === 'profile' ? 'active' : '' %>">Profile</a></li>
      <% if (currentUser) { %>
        <li><a href="/logout" class="nav-auth">Log out<%= currentUser.name ? " · " + currentUser.name : "" %></a></li>
      <% } else { %>
        <li><a href="/login" class="<%= active === 'login' ? 'active' : '' %>">Log in</a></li>
      <% } %>
    </ul>
  </nav>
