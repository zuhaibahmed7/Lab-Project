<%- include('partials/header', { title: 'Log in' }) %>
  <main class="auth-split">
    <section class="auth-card">
      <div class="auth-visual">
        <img src="/assets/aistudio/image_0aa5a6e2.png" alt="Sukkur IBA University campus" referrerpolicy="no-referrer" onerror="this.style.display='none'">
        <div class="auth-visual-scrim">
          <p class="auth-visual-kicker">Sukkur IBA University · Alumni Network</p>
          <h2>Stay connected with your graduating class</h2>
          <p>Sign in to access the alumni directory, search graduates by department or city, and view fellow alumni dossiers.</p>
        </div>
      </div>

      <div class="auth-form-pane">
        <h1>Sign in</h1>
        <p class="auth-form-subtitle">Enter your registered email and password to continue.</p>

        <form action="/login" method="post">
          <div class="field">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required autofocus>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
          </div>

          <button type="submit" class="btn-primary">Log in</button>
        </form>

        <p class="auth-alt">New to AlumniConnect? <a href="/register">Create an alumni profile</a></p>
      </div>
    </section>
  </main>
<%- include('partials/footer') %>
