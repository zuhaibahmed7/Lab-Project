<%- include('partials/header') %>
  <main>
    <section class="form-container message-box <%= type %>">
      <h1><%= title %></h1>
      <p><%= text %></p>
      <div class="profile-actions">
        <% if (type === "success") { %>
          <a class="btn" href="/alumni">View Alumni Directory</a>
        <% } else { %>
          <a class="btn" href="/register">Go Back</a>
        <% } %>
      </div>
    </section>
  </main>
<%- include('partials/footer') %>
